# Always install devDependencies, even when NODE_ENV=production.
#
# npm treats NODE_ENV=production as --omit=dev. On a host that sets it, `npm ci`
# then silently drops the packages `next build` needs and the image fails with
# "Cannot find module" naming a package that is plainly listed in package.json.
#
# The build-critical packages have also been moved into `dependencies`, so the
# build survives even without this file. This is the second lock on the door.
include=dev
